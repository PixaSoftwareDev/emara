---
import type { Translations } from '~/i18n/ui';
import { images } from '~/assets/images';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---
<section class="section why" id="why">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">{t.why.eyebrow}</span>
      <h2 class="section-title">{t.why.title}</h2>
    </div>

    <div class="why-grid">
      <figure class="why-media">
        <img src={images.whyPoloFoot} alt="Polo close-up — equestrian craftsmanship" loading="lazy" />
        <figcaption class="why-media-caption" aria-hidden="true">
          <span class="why-media-rule"></span>
          Craftsmanship in motion
        </figcaption>
      </figure>
      <ul class="why-list">
        {t.why.items.map((item) => (
          <li>
            <span class="why-check">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
