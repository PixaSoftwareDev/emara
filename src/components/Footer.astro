---
import type { Translations } from '~/i18n/ui';
import { images } from '~/assets/images';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---
<footer class="footer">
  <div class="footer-bridge" aria-hidden="true">
    <span class="footer-bridge-rule"></span>
    <img src={images.footerFlags} alt="" class="footer-bridge-image" />
    <span class="footer-bridge-rule"></span>
  </div>
  <div class="container footer-container">
    <div class="footer-brand">
      <img src="/Logo.png" alt="Emara Logo" class="footer-logo" />
      <p class="footer-tagline">{t.footer.tagline}</p>
    </div>
    <div class="footer-links">
      <a href="#about">{t.nav.about}</a>
      <a href="#services">{t.nav.services}</a>
      <a href="#mission">{t.nav.mission}</a>
      <a href="#contact">{t.nav.contact}</a>
    </div>
    <div class="footer-meta">
      <p>&copy; <span id="year"></span> Emara by Khordad Enterprises.</p>
      <p>{t.footer.rights}</p>
    </div>
  </div>
</footer>
