---
import type { Translations } from '~/i18n/ui';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---
<section class="hero" id="hero">
  <div class="hero-aurora" aria-hidden="true">
    <span class="aurora-blob aurora-blob-1"></span>
    <span class="aurora-blob aurora-blob-2"></span>
    <span class="aurora-blob aurora-blob-3"></span>
  </div>
  <div class="container hero-container">
    <div class="hero-media" data-parallax="0.14">
      <div class="hero-media-frame">
        <span class="hero-media-corner hero-media-corner--tl" aria-hidden="true"></span>
        <span class="hero-media-corner hero-media-corner--br" aria-hidden="true"></span>
        <img src="/Logo.png" alt="Emara by Khordad Enterprises" class="hero-logo" />
      </div>
    </div>
    <div class="hero-content">
      <span class="hero-eyebrow" data-parallax="0.04">
        <span class="hero-eyebrow-rule" aria-hidden="true"></span>
        Emara <span class="hero-eyebrow-dot" aria-hidden="true">·</span> Khordad Enterprises
      </span>
      <h1 class="hero-title" data-parallax="0.07">
        <span>{t.hero.titleStart}</span>
        <span class="accent">{t.hero.titleAccent}</span>
      </h1>
      <p class="hero-subtitle" data-parallax="0.04">{t.hero.subtitle}</p>
      <div class="hero-cta">
        <a href="#services" class="btn btn-primary">{t.hero.ctaPrimary}</a>
        <a href="#contact" class="btn btn-ghost">{t.hero.ctaSecondary}</a>
      </div>
    </div>
  </div>
  <div class="hero-scroll">
    <span>{t.hero.scroll}</span>
    <div class="scroll-line"></div>
  </div>
</section>
