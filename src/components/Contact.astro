---
import type { Translations } from '~/i18n/ui';
import { images } from '~/assets/images';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---
<section class="section contact" id="contact">
  <div class="contact-banner" style={`background-image: url(${images.contactDesert});`} aria-hidden="true">
    <div class="contact-banner-overlay"></div>
  </div>
  <div class="container">
    <div class="section-header center">
      <span class="section-eyebrow">{t.contact.eyebrow}</span>
      <h2 class="section-title">{t.contact.title}</h2>
      <p class="section-lead">{t.contact.lead}</p>
    </div>

    <div class="contact-grid">
      <a href="mailto:info@emara-equestrian.com" class="contact-card">
        <div class="contact-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </div>
        <span class="contact-label">{t.contact.emailLabel}</span>
        <span class="contact-value">info@emara-equestrian.com</span>
      </a>

      <a href="https://wa.me/971501953595" target="_blank" rel="noopener" class="contact-card">
        <div class="contact-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
        </div>
        <span class="contact-label">{t.contact.whatsappLabel}</span>
        <span class="contact-value">+971 50 195 3595</span>
      </a>
    </div>

    <p class="contact-signoff">{t.contact.signoff}</p>
  </div>
</section>
